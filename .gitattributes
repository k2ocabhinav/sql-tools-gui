# Detect text files and normalize repository blobs to LF.
* text=auto

# Keep source, configuration, documentation, and shell launchers stable across OSes.
*.command text eol=lf
*.json text eol=lf
*.lock text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.spec text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Windows launchers use native line endings when checked out on Windows.
*.bat text eol=crlf
*.cmd text eol=crlf
